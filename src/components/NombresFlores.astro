---
// src/components/NombresFlores.astro
// Foto de los novios a todo el ancho, desvanecida abajo hacia el blanco,
// con la rama de gypsophila apoyada en la esquina derecha.
//
// El desvanecido va con máscara y no con un degradado blanco encima: así
// el corte sigue siendo blanco venga de donde venga el fondo de la página.
// ── DATOS EDITABLES ───────────────────────────────────────────
const altFoto = "Los novios";
// ──────────────────────────────────────────────────────────────
---

<section class="seccion-novios">
    <div class="foto-wrap">
        <img
            id="foto-novios"
            src="/imagenes/foto2.png"
            alt={altFoto}
            width="1008"
            height="1561"
            class="foto-novios"
        />

        <img
            id="flor-novios"
            src="/imagenes/flor5.png"
            alt=""
            width="1080"
            height="742"
            class="flor-novios"
            aria-hidden="true"
        />
    </div>
</section>

<style>
    .seccion-novios {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    /* Columna móvil: la foto va a todo el ancho, sin márgenes */
    .foto-wrap {
        position: relative;
        width: 100%;
        max-width: 430px;
    }

    /*
       La foto se apaga en el último tramo de su alto. Va en máscara para
       que el degradado no tape la rama que apoya encima.
    */
    .foto-novios {
        display: block;
        width: 100%;
        height: auto;
        -webkit-mask-image: linear-gradient(
            to bottom,
            #000 70%,
            rgba(0, 0, 0, 0.45) 88%,
            transparent 100%
        );
        mask-image: linear-gradient(
            to bottom,
            #000 70%,
            rgba(0, 0, 0, 0.45) 88%,
            transparent 100%
        );
    }

    /*
       La rama entra desde el borde derecho, apoyada en el desvanecido.
       El ancho es el que la deja a la escala de la foto; el alto sale solo.
    */
    .flor-novios {
        position: absolute;
        right: -3%;
        bottom: 0;
        width: 48%;
        height: auto;
        pointer-events: none;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const foto = document.getElementById("foto-novios");
        const flor = document.getElementById("flor-novios");
        if (!foto) return;

        // La foto se acerca apenas al entrar y la rama la sigue un poco
        // después, para que no aparezcan como un bloque solo.
        gsap.from(foto, {
            scrollTrigger: { trigger: foto, start: "top 85%" },
            opacity: 0,
            scale: 1.04,
            duration: 1.2,
            ease: "power2.out",
        });

        gsap.from(flor, {
            scrollTrigger: { trigger: foto, start: "top 85%" },
            opacity: 0,
            x: 26,
            duration: 1,
            delay: 0.35,
            ease: "power2.out",
        });
    });
</script>
