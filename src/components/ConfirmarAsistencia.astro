---
// src/components/ConfirmarAsistencia.astro
// Pedido de confirmación: el texto y el botón que abre WhatsApp,
// dentro de un marco fino, con una rama apoyada en cada esquina opuesta.
// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Confirmar asistencia";

const parrafos = [
    "¡Nuestra mayor ilusión es celebrar contigo!",
    "Por favor, ayúdanos a preparar todo con amor confirmando tu asistencia.",
];

const textoBoton = "Confirmar";
const cierre = "Nos encantaría compartir nuestra felicidad contigo";

// WhatsApp de los novios, con el código de país y sin signos ni espacios
const whatsapp = "59172105495";

// El mensaje se arma con estos dos, así los nombres y la fecha no quedan
// escritos a mano dentro de la frase.
const novios = "Maquiber y Elva Adriana";
const diaBoda = "5 de diciembre de 2026";
// ──────────────────────────────────────────────────────────────

const mensaje = `Me complace confirmar mi asistencia a la boda de ${novios} para el día ${diaBoda}. ¡Ahí estaré sin falta!`;

const enlace = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensaje)}`;
---

<section id="confirmar-asistencia" class="confirmar">
    <div class="marco">
        <!-- Rama en la esquina de arriba a la izquierda -->
        <img
            src="/imagenes/flor5.png"
            alt=""
            width="1080"
            height="742"
            class="rama rama-arriba"
            aria-hidden="true"
        />

        <h2 class="titulo">{titulo}</h2>

        <div class="texto">
            {parrafos.map((parrafo) => <p class="parrafo">{parrafo}</p>)}
        </div>

        <a
            class="boton"
            href={enlace}
            target="_blank"
            rel="noopener noreferrer"
        >
            {textoBoton}
        </a>

        <p class="cierre font-great-vibes">{cierre}</p>

        <!-- Rama apoyada en la esquina de abajo a la derecha -->
        <img
            src="/imagenes/flor5.png"
            alt=""
            width="1080"
            height="742"
            class="rama rama-abajo"
            aria-hidden="true"
        />
    </div>
</section>

<style>
    /*
       Simonetta se declara acá también: cada bloque tiene que poder
       dibujarse aunque los demás no estén en la página.
    */
    @font-face {
        font-family: "Simonetta";
        src: url("/fonts/Simonetta-Regular.ttf") format("truetype");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
    }

    .confirmar {
        --azul: #284f80;

        width: 100%;
        max-width: 430px;
        margin: 0 auto;
        padding: 1.5rem;
        text-align: center;
        font-family: "Simonetta", serif;
        color: var(--azul);

        /*
           Blanco declarado como imagen y no como color: el modo oscuro
           forzado del navegador oscurece colores pero respeta las imágenes.
        */
        background-image: linear-gradient(#fff, #fff);
    }

    /*
       El marco es también el que ubica las ramas. No lleva overflow: las
       dos tienen que poder asomar por fuera del recuadro.
    */
    .marco {
        position: relative;
        padding: 2.2rem 1.4rem 2.6rem;
        border: 1px solid rgba(40, 79, 128, 0.4);
        border-radius: 10px;
    }

    .titulo {
        font-size: clamp(1.15rem, 5.4vw, 1.4rem);
        letter-spacing: 0.1em;
        /* compensa el hueco que el tracking deja tras la última letra */
        text-indent: 0.1em;
        line-height: 1.6;
        font-weight: 400;
        text-transform: uppercase;
    }

    /*
       Los párrafos cortan solos dentro de este ancho: con renglones
       cortados a mano, al cambiar el cuerpo quedan palabras sueltas.
    */
    .texto {
        max-width: 19rem;
        margin: 1.4rem auto 0;
    }

    .parrafo {
        font-size: clamp(1.05rem, 5vw, 1.28rem);
        letter-spacing: 0.02em;
        line-height: 1.75;
    }

    .parrafo + .parrafo {
        margin-top: 0.9rem;
    }

    /* Mismo botón que el "Ver ubicación" de las tarjetas de dirección */
    .boton {
        display: inline-block;
        position: relative;
        z-index: 1;
        margin-top: 1.8rem;
        padding: 0.55rem 1.4rem;
        border: 1px solid rgba(40, 79, 128, 0.55);
        color: var(--azul);
        font-size: clamp(1.05rem, 5vw, 1.28rem);
        letter-spacing: 0.1em;
        text-indent: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
    }

    .cierre {
        max-width: 17rem;
        margin: 1.8rem auto 0;
        font-size: clamp(1.6rem, 7.6vw, 2rem);
        line-height: 1.35;
    }

    /*
       Las ramas van por delante del recuadro, apoyadas sobre sus esquinas,
       igual que en el código de vestimenta. El recorte trae el ramo pegado
       al borde derecho: la de abajo entra tal cual desde la derecha y la
       de arriba se espeja para entrar desde la izquierda.
    */
    .rama {
        position: absolute;
        z-index: 2;
        width: 46%;
        height: auto;
        pointer-events: none;
    }

    .rama-arriba {
        top: -6%;
        left: -16%;
        transform: scaleX(-1);
    }

    .rama-abajo {
        right: -16%;
        bottom: -6%;
    }
</style>

<script>
    import { animarEntrada } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("confirmar-asistencia");
        const marco = seccion?.querySelector(".marco");
        if (!seccion || !marco) return;

        // La rama queda fuera: entra con el marco y no necesita su propio
        // movimiento, que además le correría la posición.
        animarEntrada(
            marco.querySelectorAll<HTMLElement>(":scope > *:not(.rama)"),
            seccion,
        );
    });
</script>
