---
// src/components/Versiculo.astro
// La cita sobre fondo blanco, en Simonetta y en el azul del diseño.
// ── DATOS EDITABLES ───────────────────────────────────────────
const versiculo =
    "El amor es paciente, es bondadoso. El amor no es envidioso ni jactancioso ni orgulloso. No se comporta con rudeza, no es egoísta, no se enoja fácilmente, no guarda rencor. El amor no se deleita en la maldad, sino que se regocija con la verdad. Todo lo disculpa, todo lo cree, todo lo espera, todo lo soporta.";
const cita = "(1 Corintios 13:4-7)";
// ──────────────────────────────────────────────────────────────
---

<section id="versiculo" class="versiculo">
    <p class="texto">{versiculo}</p>

    <p class="cita">{cita}</p>
</section>

<style>
    /*
       Simonetta se declara acá también: cada bloque tiene que poder
       dibujarse aunque los demás no estén en la página.
    */
    @font-face {
        font-family: "Simonetta";
        src: url("/fonts/Simonetta-Regular.ttf") format("truetype");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
    }

    @font-face {
        font-family: "Simonetta";
        src: url("/fonts/Simonetta-Italic.ttf") format("truetype");
        font-weight: 400;
        font-style: italic;
        font-display: swap;
    }

    .versiculo {
        --azul: #284f80;

        width: 100%;
        max-width: 430px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        text-align: center;
        font-family: "Simonetta", serif;
        color: var(--azul);

        /*
           Blanco declarado como imagen y no como color: el modo oscuro
           forzado del navegador oscurece colores pero respeta las imágenes.
        */
        background-image: linear-gradient(#fff, #fff);
    }

    /*
       El versículo corta solo dentro de este ancho. Es largo: con el
       interlineado de antes (2.4) ocupaba media pantalla de más.
    */
    .texto {
        max-width: 20rem;
        margin: 0 auto;
        font-size: clamp(1.05rem, 5vw, 1.28rem);
        letter-spacing: 0.02em;
        line-height: 1.8;
    }

    .cita {
        margin-top: 1.6rem;
        font-size: clamp(1.15rem, 5.2vw, 1.4rem);
        letter-spacing: 0.08em;
        text-indent: 0.08em;
        font-style: italic;
    }
</style>

<script>
    import { animarEntrada } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("versiculo");
        if (!seccion) return;

        animarEntrada(
            seccion.querySelectorAll<HTMLElement>(":scope > *"),
            seccion,
        );
    });
</script>
