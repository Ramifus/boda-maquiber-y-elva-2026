---
// src/components/Fecha.astro
// El bloque de la fecha: anuncio, nombres, fecha, cuenta regresiva y el
// calendario del mes con el día marcado.
//
// La cuenta regresiva usa ids propios (f-dias, f-horas...) y no los de
// Contador.astro: si los dos bloques estuvieran en la misma página, ids
// repetidos harían que el reloj escriba siempre en el primero.
// ── DATOS EDITABLES ───────────────────────────────────────────
const anuncio = "¡Nos Casamos!";
const novios = "Stephanie y Jorge";
const fecha = "05.12.26";
const tituloCuenta = "Solo faltan...";

// Fecha y hora de la boda (año, mes, día, hora, minuto)
const fechaBoda = "2026-12-05T12:00:00";

const mes = "Diciembre";
const anio = 2026;
const mesIndice = 11; // 0 = enero ... 11 = diciembre
const diaBoda = 5;
// ──────────────────────────────────────────────────────────────

const casillas = [
    { id: "f-dias", rotulo: "Días" },
    { id: "f-horas", rotulo: "Horas" },
    { id: "f-minutos", rotulo: "Minutos" },
    { id: "f-segundos", rotulo: "Segundos" },
];

// La semana arranca en lunes, como en el diseño: getDay() devuelve 0 para
// el domingo, así que se corre un lugar.
const cabeceras = ["L", "M", "M", "J", "V", "S", "D"];
const primerDia = (new Date(anio, mesIndice, 1).getDay() + 6) % 7;
const diasDelMes = new Date(anio, mesIndice + 1, 0).getDate();

const celdas: (number | null)[] = [
    ...Array(primerDia).fill(null),
    ...Array.from({ length: diasDelMes }, (_, i) => i + 1),
];
while (celdas.length % 7 !== 0) celdas.push(null);
---

<section id="bloque-fecha" class="bloque-fecha">
    <!-- Rama en la esquina de arriba a la izquierda, detrás del texto -->
    <img
        src="/imagenes/flor5.png"
        alt=""
        width="1080"
        height="742"
        class="flor-esquina"
        aria-hidden="true"
    />

    <p class="anuncio">{anuncio}</p>

    <h2 class="novios font-great-vibes">{novios}</h2>

    <p class="fecha">{fecha}</p>

    <p class="titulo-cuenta">{tituloCuenta}</p>

    <!-- CUENTA REGRESIVA -->
    <div id="cuenta" class="cuenta" data-fecha={fechaBoda}>
        {
            casillas.map((casilla, i) => (
                <>
                    {i > 0 && <span class="dospuntos">:</span>}
                    <div class="unidad">
                        <span id={casilla.id} class="numero">
                            00
                        </span>
                        <span class="rotulo">{casilla.rotulo}</span>
                    </div>
                </>
            ))
        }
    </div>

    <!-- CALENDARIO -->
    <div id="calendario" class="calendario">
        <div class="calendario-cabecera">
            <span class="mes font-great-vibes">{mes}</span>
            <span class="anio font-great-vibes">{anio}</span>
        </div>

        <div class="grilla">
            {cabeceras.map((letra) => <span class="dia-letra">{letra}</span>)}
            {
                celdas.map((dia) => (
                    <span class={`dia ${dia === diaBoda ? "dia-boda" : ""}`}>
                        {dia === diaBoda && (
                            <svg
                                class="corazon"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="#c6a24a"
                                stroke-width="1.5"
                                aria-hidden="true"
                            >
                                <path d="M12 21s-7.5-4.7-9.3-9A5.3 5.3 0 0 1 12 6.5 5.3 5.3 0 0 1 21.3 12c-1.8 4.3-9.3 9-9.3 9z" />
                            </svg>
                        )}
                        <span class="dia-numero">{dia ?? ""}</span>
                    </span>
                ))
            }
        </div>
    </div>

    <!-- Separador floral, centrado debajo del calendario -->
    <img
        id="separador"
        src="/imagenes/florseparador.png"
        alt=""
        width="1065"
        height="378"
        class="separador"
        aria-hidden="true"
    />

    <!-- La misma rama abajo a la derecha, cerrando el bloque -->
    <img
        src="/imagenes/flor5.png"
        alt=""
        width="1080"
        height="742"
        class="flor-esquina flor-abajo"
        aria-hidden="true"
    />
</section>

<style>
    /*
       Simonetta se declara acá también: la portada la trae en su propio
       bloque y este componente tiene que poder dibujarse aunque la portada
       no esté en la página.
    */
    @font-face {
        font-family: "Simonetta";
        src: url("/fonts/Simonetta-Regular.ttf") format("truetype");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
    }

    @font-face {
        font-family: "Simonetta";
        src: url("/fonts/Simonetta-Italic.ttf") format("truetype");
        font-weight: 400;
        font-style: italic;
        font-display: swap;
    }

    @font-face {
        font-family: "Simonetta";
        src: url("/fonts/Simonetta-Black.ttf") format("truetype");
        font-weight: 900;
        font-style: normal;
        font-display: swap;
    }

    @font-face {
        font-family: "Simonetta";
        src: url("/fonts/Simonetta-BlackItalic.ttf") format("truetype");
        font-weight: 900;
        font-style: italic;
        font-display: swap;
    }

    /*
       z-index 0 arma la caja de apilado del bloque: así la rama, que va en
       -1, queda encima del fondo pero debajo del texto sin irse detrás de
       la página entera.
    */
    .bloque-fecha {
        --azul: #284f80;
        --dorado: #c6a24a;
        --negro: #000000;

        position: relative;
        z-index: 0;
        width: 100%;
        max-width: 430px;
        margin: 0 auto;
        padding: 2rem 1.5rem 2.2rem;
        text-align: center;
        font-family: "Simonetta", serif;
        color: var(--azul);

        /*
           El fondo con textura, en tamaño original como en la portada.
           Va con attachment scroll y no fixed: en una sección que scrollea,
           el fixed se rompe en Safari de iPhone.
        */
        background-image: url("/imagenes/fondoplomo.png");
        background-size: auto;
        background-position: center;
        background-repeat: no-repeat;
    }

    .anuncio {
        font-size: clamp(0.95rem, 4.3vw, 1.15rem);
        letter-spacing: 0.16em;
        text-indent: 0.16em;
        text-transform: uppercase;
    }

    .novios {
        margin-top: 0.9rem;
        font-size: clamp(2.4rem, 11.5vw, 3.1rem);
        line-height: 1.25;
        font-weight: 400;
    }

    .fecha {
        margin-top: 1.1rem;
        font-size: clamp(1.15rem, 5.4vw, 1.4rem);
        letter-spacing: 0.3em;
        /* compensa el hueco que el tracking deja después del último signo */
        text-indent: 0.3em;
    }

    .titulo-cuenta {
        margin-top: 2.8rem;
        font-size: clamp(0.98rem, 4.5vw, 1.18rem);
        letter-spacing: 0.16em;
        text-indent: 0.16em;
        text-transform: uppercase;
    }

    /*
       Los dos puntos van alineados con los números y no con el bloque
       entero: si se centran, quedan a la altura de los rótulos.
    */
    .cuenta {
        margin-top: 1.4rem;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        gap: 0.35rem;
    }

    .unidad {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 0;
    }

    .numero {
        color: var(--negro);
        font-size: clamp(1.8rem, 8.8vw, 2.4rem);
        line-height: 1.2;
        letter-spacing: 0.04em;
    }

    .dospuntos {
        color: var(--negro);
        font-size: clamp(1.8rem, 8.8vw, 2.4rem);
        line-height: 1.2;
    }

    .rotulo {
        color: var(--negro);
        margin-top: 0.5rem;
        font-size: clamp(0.62rem, 2.9vw, 0.74rem);
        letter-spacing: 0.14em;
        text-indent: 0.14em;
        text-transform: uppercase;
    }

    /*
       La rama va en la esquina izquierda, espejada: el recorte trae el ramo
       pegado al borde derecho, así que volteada entra desde la izquierda.
       Sube por encima del borde del bloque: la sección no recorta, así que
       la rama asoma entera sobre lo que viene arriba.
    */
    .flor-esquina {
        position: absolute;
        top: -4.5%;
        left: 0;
        z-index: -1;
        width: 38%;
        height: auto;
        transform: scaleX(-1);
        pointer-events: none;
    }

    /*
       Abajo a la derecha va sin espejar: el recorte ya trae el ramo pegado
       a ese borde, así que entra desde la derecha tal cual viene.
    */
    .flor-abajo {
        top: auto;
        left: auto;
        bottom: -4.5%;
        right: -4%;
        width: 32%;
        transform: none;
    }

    .separador {
        display: block;
        width: 62%;
        max-width: 240px;
        height: auto;
        margin: 1.6rem auto 0;
    }

    .calendario {
        width: 100%;
        max-width: 320px;
        margin: 3rem auto 0;
    }

    .calendario-cabecera {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        padding: 0 0.4rem;
        margin-bottom: 1.1rem;
    }

    .mes,
    .anio {
        font-size: clamp(1.5rem, 7.2vw, 1.85rem);
        line-height: 1.2;
    }

    .grilla {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        row-gap: 0.75rem;
        text-align: center;
    }

    .dia-letra {
        font-size: clamp(0.78rem, 3.7vw, 0.92rem);
        letter-spacing: 0.06em;
        padding-bottom: 0.35rem;
    }

    .dia {
        position: relative;
        font-size: clamp(0.8rem, 3.9vw, 0.95rem);
        line-height: 1.5;
    }

    /* El día de la boda va más marcado, con el corazón dorado detrás */
    .dia-boda .dia-numero {
        font-weight: 900;
    }

    .corazon {
        position: absolute;
        inset: 0;
        margin: auto;
        width: clamp(24px, 7.6vw, 30px);
        height: clamp(24px, 7.6vw, 30px);
        transform: translateY(-1px);
    }

    .dia-numero {
        position: relative;
    }
</style>

<script>
    import { animarEntrada } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const bloque = document.getElementById("bloque-fecha");
        if (!bloque) return;

        // La rama queda fuera de la animación a propósito: animarEntrada
        // escribe su propio transform y le borraría el volteo horizontal,
        // con lo que el ramo se despega del borde izquierdo.
        animarEntrada(
            bloque.querySelectorAll<HTMLElement>(
                ":scope > *:not(.flor-esquina)",
            ),
            bloque,
        );

        // ── Cuenta regresiva ────────────────────────────────────
        const cuenta = document.getElementById("cuenta");
        if (!cuenta) return;

        const objetivo = new Date(cuenta.dataset.fecha as string).getTime();
        const el = (id: string) => document.getElementById(id);

        const pintar = () => {
            const resta = Math.max(objetivo - Date.now(), 0);
            const seg = Math.floor(resta / 1000);

            const dias = Math.floor(seg / 86400);
            const horas = Math.floor((seg % 86400) / 3600);
            const minutos = Math.floor((seg % 3600) / 60);
            const segundos = seg % 60;

            const dosDigitos = (n: number) => n.toString().padStart(2, "0");

            const d = el("f-dias");
            const h = el("f-horas");
            const m = el("f-minutos");
            const s = el("f-segundos");
            if (d) d.textContent = dias.toString();
            if (h) h.textContent = dosDigitos(horas);
            if (m) m.textContent = dosDigitos(minutos);
            if (s) s.textContent = dosDigitos(segundos);
        };

        pintar();
        setInterval(pintar, 1000);
    });
</script>
